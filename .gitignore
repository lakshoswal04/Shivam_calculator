# ---- dependencies & build output -------------------------------------------
node_modules/
.next/
out/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.turbo/

# ---- secrets ---------------------------------------------------------------
.env
.env.local
.env*.local
!.env.example

# ---- derived pipeline artefacts --------------------------------------------
# Regenerable from corpus/ with ./run_pipeline.sh. Excluded because they are
# large and change on every run; the committed snapshot in db/snapshot/ is the
# fast path for rebuilding a database.
data/extracted/
data/structured/*/

# ---- bulk SEBI master circulars --------------------------------------------
# 131 PDFs, 211 MB, against a 65 MB repository. The bytes are excluded; the
# provenance is not. Each .meta.json sidecar beside the omitted PDF carries its
# official SEBI URL and its SHA-256, data/inventory/inventory.json records every
# hash, and `python pipeline/sebi_scraper.py` re-fetches and verifies against
# them. Nothing that anchors a citation depends on the bytes being in git.
#
# corpus/originals/ is NOT covered by this: the documents the live rules cite
# stay in the repository, including the ICDR and LODR master circulars.
corpus/fetched/sebi_master_circulars/*.pdf

# ---- tooling noise ---------------------------------------------------------
.DS_Store
*.log
next-env.d.ts
AGENTS.md
CLAUDE.md
.netlify/
